{
  "name": "auto-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "A real-time dashboard for streaming metrics",
  "type": "module",
  "bin": {
    "dashboard": "./scripts/dashboard.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dashboard": "node scripts/dashboard.mjs --production",
    "dashboard:dev": "node scripts/dashboard.mjs",
    "dashboard:build": "npm run build && node scripts/dashboard.mjs --production",
    "resource-usage": "scripts/resource-usage.sh",
    "resource-dashboard": "mkdir -p data && touch data/resource-usage.jsonl && concurrently -k \"scripts/resource-usage.sh data/resource-usage.jsonl\" \"npm run dashboard -- -d cpu_percent -m _ avg rolling_avg -x timestamp -d memory_percent -m _ avg rolling_avg -x timestamp -d load_1m -m _ avg rolling_avg -x timestamp -p data/resource-usage.jsonl\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "npm run electron:dev",
    "electron:dev": "concurrently -k \"vite --force\" \"wait-on http://localhost:5173/ && electron --gtk-version=3 --ozone-platform=x11 .\"",
    "electron:preview": "electron --gtk-version=3 --ozone-platform=x11 .",
    "electron:build": "npm run build && electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs"
}